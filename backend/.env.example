# Copy to backend/.env, then fill in the two required values.
# Vapor loads .env and .env.<environment> from its working directory.
# Process environment > .env.<environment> > .env.
# Restart the backend after changing this file. Do not commit real credentials.

# Required for Kite browser login. Obtain both from https://developers.kite.trade/.
# Register http://127.0.0.1:8080/kite/callback for a native backend on this Mac.
KITE_API_KEY=
KITE_API_SECRET=

# Optional. Default: info in development, notice in production.
# Docker Compose defaults to info unless this variable overrides it.
# Values: trace, debug, info, notice, warning, error, critical.
# LOG_LEVEL=info

# Optional for native deployments. Default: ~/.unaru under the backend user.
# Use an absolute path. Docker Compose uses its named volume at /app/.unaru.
# UNARU_DATA_DIRECTORY=/absolute/path/to/unaru-state

# Optional, legacy clients only. New Mac connections use pairing automatically.
# Leave unset unless migrating an existing manually configured connection.
# UNARU_CONNECTION_TOKEN=

# Select the Vapor environment with --env production, or export VAPOR_ENV before
# launch. VAPOR_ENV is read before dotenv files, so setting it here has no effect.
# The hostname and port are command options: --hostname 127.0.0.1 --port 8080.
