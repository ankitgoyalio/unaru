# Use SwiftFormat 0.64.5 (see docs/development.md).
--min-version 0.64.5
--swift-version 6.4
--indent 4
--allman false
--commas always
--self remove
# Scripts/format-swift.py owns header generation and validation.
--header ignore
--exclude **/DocumentationExamples.swift,.build,**/.build,.scratch,Vendor,vendor,**/Generated/**,**/generated/**,**/*.generated.swift,**/*.g.swift
--blank-line-after-switch-case "always"
--line-between-guards "true"
--boolean-guards-in-tests "convert"
--guard-like-if-statements "convert"
--property-types "inferred"
--test-case-name-format preserve
--disable noForceTryInTests,noForceUnwrapInTests
